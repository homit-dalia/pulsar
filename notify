#!/bin/sh
# Queue a WhatsApp message to the owner; the bridge sends it within a second.
#   notify "text"
#   notify --file /path/to/file ["caption"]
set -eu
outbox="${DATA_DIR:-/data}/outbox"
file=""
if [ "${1:-}" = "--file" ]; then
  [ -r "${2:-}" ] || { echo "notify: cannot read file '${2:-}'" >&2; exit 1; }
  file=$(realpath "$2")
  shift 2
fi
text="$*"
[ -n "$text$file" ] || { echo 'usage: notify "text" | notify --file PATH ["caption"]' >&2; exit 2; }
tmp=$(mktemp "$outbox/.notify.XXXXXX")
jq -n --arg text "$text" --arg file "$file" '{text: $text, file: $file}' > "$tmp"
mv "$tmp" "$outbox/$(date +%s%N)-${tmp##*.}.json"
