#!/bin/sh
# Queue a WhatsApp message to the owner: a row in agent.messages, which the bridge sends within a second.
#   notify "text"
#   notify --file /path/to/file ["caption"]
set -eu
file=""
if [ "${1:-}" = "--file" ]; then
  [ -r "${2:-}" ] || { echo "notify: cannot read file '${2:-}'" >&2; exit 1; }
  file=$(realpath "$2")
  shift 2
fi
text="$*"
[ -n "$text$file" ] || { echo 'usage: notify "text" | notify --file PATH ["caption"]' >&2; exit 2; }
psql "$DATABASE_URL" -X -q -v ON_ERROR_STOP=1 -v body="$text" -v file="$file" -v run="${RUN_ID:-}" <<'SQL'
insert into agent.messages (direction, body, file_path, run_id)
values ('out', :'body', nullif(:'file', ''), nullif(:'run', '')::bigint);
SQL
